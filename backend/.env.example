# EPMS Backend Environment Configuration Template
# Server Configuration
PORT=4000
BACKEND_STORAGE_URL=http://localhost:4000
APP_URL=http://localhost:4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=epms_app_user
DATABASE_PASSWORD=
DATABASE_NAME=epms_tvmubd_db

# Authentication Configuration
JWT_SECRET=

# Redis / Realtime Configuration (Optional - Socket.IO Adapter)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Outbox Relay Engine
OUTBOX_RELAY_CRON=* * * * *
OUTBOX_BATCH_SIZE=50

# SMTP / Email Delivery (Optional - Production Readiness)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AWS / S3 Storage (Optional - Production Readiness)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
