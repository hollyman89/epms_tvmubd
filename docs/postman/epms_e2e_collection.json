{
  "info": {
    "name": "EPMS E2E Integration",
    "description": "E2E API Test for Purchase Request to Invoice Payment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login as Procurement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/v1/auth/login",
          "host": [
            "http://localhost:4000/api/v1/auth/login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"procurement@tvmubd.com\",\"password\":\"123456\"}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.environment.set(\"token\", jsonData.data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create Purchase Request (PR)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/v1/procurement/pr",
          "host": [
            "http://localhost:4000/api/v1/procurement/pr"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"projectId\":1,\"items\":[{\"itemName\":\"Server Rack\",\"quantity\":2,\"estimatedUnitPrice\":15000000}],\"totalEstimatedAmount\":30000000}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "3. Vendor Comparison",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/v1/procurement/vendor-comparison",
          "host": [
            "http://localhost:4000/api/v1/procurement/vendor-comparison"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"rfqId\":1,\"vendors\":[{\"vendorId\":1,\"offeredAmount\":45000000,\"isWinner\":true}]}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4. Create Purchase Order (PO)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/v1/procurement/purchase-orders",
          "host": [
            "http://localhost:4000/api/v1/procurement/purchase-orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"purchase_request_id\":1,\"vendor_id\":1,\"po_items\":[{\"item_name\":\"Server Rack\",\"quantity\":2,\"unit_price\":15000000,\"total_price\":30000000}]}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "5. Goods Receipt (GR)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/v1/procurement/goods-receipts",
          "host": [
            "http://localhost:4000/api/v1/procurement/goods-receipts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"purchaseOrderId\":1,\"receiptDate\":\"2026-07-20T10:00:00Z\",\"remarks\":\"Received by warehouse\",\"items\":[{\"poItemId\":1,\"receivedQuantity\":2,\"remarks\":\"Good condition\"}]}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "6. Create Invoice (Finance)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/v1/finance/invoices",
          "host": [
            "http://localhost:4000/api/v1/finance/invoices"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"purchaseOrderId\":1,\"invoiceDate\":\"2026-07-20T10:00:00Z\",\"items\":[{\"poItemId\":1,\"quantity\":2,\"unitPrice\":15000000,\"totalPrice\":30000000}]}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "7. Process Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:4000/api/v1/finance/payments",
          "host": [
            "http://localhost:4000/api/v1/finance/payments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"invoiceId\":1,\"paymentDate\":\"2026-07-21T10:00:00Z\",\"paymentAmount\":30000000,\"paymentMethod\":\"BANK_TRANSFER\",\"referenceNumber\":\"TRX-12345\"}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}